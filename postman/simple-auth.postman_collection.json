            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "",
                  "const user = pm.response.json();",
                  "pm.test(\"Returns the created user\", () => {",
                  "    pm.expect(user.email).to.equal(pm.collectionVariables.get(\"managedUserEmail\"));",
                  "    pm.expect(user).to.not.have.property(\"passwordHash\");",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"managedUserId\", user.id);"
                ]
              }
            }
